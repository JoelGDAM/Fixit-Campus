<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra superior morada con el usuario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/morado"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/ivPerfil"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_avatar"
                android:contentDescription="Perfil"
                android:padding="8dp"
                android:src="@drawable/ic_profile" />

            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Alumno Campus"
                android:textColor="@color/texto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivAjustes"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Cerrar sesión"
                android:padding="8dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis avisos"
                android:textColor="@color/texto"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Buscador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/ivBuscar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Buscar"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/etBuscar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Buscar avisos..."
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/texto"
                    android:textColorHint="@color/secundario"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivFiltro"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Filtro"
                    android:padding="6dp"
                    android:src="@drawable/ic_filter" />
            </LinearLayout>

            <!-- Chips de estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipTodas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_active"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="Todas"
                    android:textColor="@color/texto"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipAbiertas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="Abiertas"
                    android:textColor="@color/secundario"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipResueltas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="Resueltas"
                    android:textColor="@color/secundario"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAvisos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="88dp"
                    android:scrollbars="none" />

                <!-- Estado vacío -->
                <LinearLayout
                    android:id="@+id/layoutVacio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="Sin avisos"
                        android:src="@drawable/ic_calendar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Todavía no tienes avisos"
                        android:textColor="@color/texto"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Cuando envíes un aviso, aparecerá aquí para que puedas consultarlo."
                        android:textColor="@color/secundario"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnNuevoVacio"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_button_primary"
                        android:text="Nuevo aviso"
                        android:textAllCaps="false"
                        android:textColor="@color/texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="24dp"
                        android:contentDescription="Campus"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_city" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNuevo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="Nuevo aviso"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/morado"
        app:borderWidth="0dp"
        app:elevation="6dp"
        app:tint="@color/texto" />

</FrameLayout>
