<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="44dp"
            android:paddingEnd="28dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="Logo FixIt Campus"
                android:src="@drawable/ic_launcher_fixit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="FixIt Campus"
                android:textColor="@color/texto"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Reporta incidencias de tu campus"
                android:textColor="@color/secundario"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="Correo"
                android:textColor="@color/secundario"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Correo"
                    android:src="@drawable/ic_email" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Correo"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textColor="@color/texto"
                    android:textColorHint="@color/secundario"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Contraseña"
                android:textColor="@color/secundario"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Contraseña"
                    android:src="@drawable/ic_lock" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Contraseña"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/texto"
                    android:textColorHint="@color/secundario"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivOjo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Mostrar contraseña"
                    android:padding="8dp"
                    android:src="@drawable/ic_eye" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOlvido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:padding="4dp"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="@color/morado"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_error"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvErrorTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No se ha podido iniciar sesión. Inténtalo de nuevo"
                    android:textColor="@color/error_texto"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_primary"
                android:text="Iniciar Sesión"
                android:textAllCaps="false"
                android:textColor="@color/texto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Demo: alumno@campus.es / 1234"
                android:textColor="@color/secundario"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/ivSilueta"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:contentDescription="Edificios del campus"
        android:scaleType="fitXY"
        android:src="@drawable/ic_city" />

</LinearLayout>
